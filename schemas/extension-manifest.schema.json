{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/extension-manifest.schema.json",
  "title": "Extension Manifest",
  "description": "Design document 9.4. Distinct from the ECU distribution manifest (11.2) and the IR manifest (8.2.6). The signature is attached to this manifest (import signature, 11.1).",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "kind", "coreVersionRange", "files"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "The agent reports the supported version in capabilities (9.5)"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "Reverse-domain format. Example: com.example.vci.xyz"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "type": "string",
      "enum": ["vciProfile", "ir", "screen", "recordTemplate", "message", "unit"]
    },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "coreVersionRange": {
      "type": "string",
      "description": "Range of supported core versions. semver range notation",
      "examples": [">=0.1.0 <0.3.0"]
    },
    "dependencies": {
      "type": "array",
      "description": "Dependencies on other extensions. Used when referencing message text or unit systems",
      "items": {
        "type": "object",
        "required": ["id", "versionRange"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "versionRange": { "type": "string" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "Content files. Hashes are kept here; the signature is attached to the manifest",
      "items": {
        "type": "object",
        "required": ["path", "digest", "sizeBytes"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": "string" }
        }
      }
    },
    "license": {
      "type": "object",
      "description": "9.4 License record. Used to restrict where it may be distributed",
      "required": ["origin", "scope"],
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string", "description": "Origin (OEM name, vendor name, organization name)" },
        "scope": { "type": "string", "enum": ["tenantOnly", "redistributable"] },
        "note": { "type": "string" }
      }
    },
    "priority": {
      "type": "integer",
      "default": 0,
      "description": "9.4 Conflict resolution. When several extensions match the same target, the higher value wins"
    }
  }
}
