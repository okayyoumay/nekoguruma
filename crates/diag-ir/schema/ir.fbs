// Schema for the IR declaration part (design document 8.2.2).
//
// Policy:
//  - Whatever the input format (ODX/OTX, CSV+JS), the frontend normalizes it into this shape (8.2)
//  - Response decoding is not interpreted at runtime; it is expanded into flat arrays at import time.
//    Variable lengths stay attributes of a flat field; only repetitions, keyed selections and
//    structures placed or sized at runtime refer to nested layouts (ADR-242)
//  - Split into one file per ECU variant, identified by hash (8.2.6)
//
// Generate: flatc --rust --gen-object-api -o src/generated schema/ir.fbs

namespace diag.ir;

file_identifier "DIR1";
file_extension "dir";

// ---------------------------------------------------------------- Basic types

enum ByteOrder : byte {
  Big = 0,   // default for vehicle diagnostics
  Little = 1,
}

enum DataKind : byte {
  Uint = 0,
  Int = 1,
  Float = 2,
  Ascii = 3,
  Bytes = 4,
  Bcd = 5,
  Utf8 = 6,
  Unicode2 = 7,  // 2-byte characters (A_UNICODE2STRING)
}

// Conversion to physical values (equivalent to COMPU-METHOD).
// No general-purpose expression engine; each kind is expressed as coefficients or arrays.
union Compu {
  CompuIdentity,
  CompuLinear,
  CompuScaleLinear,
  CompuTextTable,
  CompuTableInterp,
  CompuRational,
  CompuBytecode,
}

table CompuIdentity {}

// physical = (internal * numerator + offset) / denominator
table CompuLinear {
  numerator: double;
  denominator: double;
  offset: double;
}

table CompuScaleLinear {
  scales: [LinearScale];
}

struct LinearScale {
  lower: double;
  upper: double;
  numerator: double;
  denominator: double;
  offset: double;
}

table CompuTextTable {
  entries: [TextEntry];
  default_text_id: uint32 = 0; // message text is resolved on the extension side (9.2)
}

// One COMPU-SCALE of a TEXTTABLE: internal values lower..upper (inclusive) map to the text.
// A single value has lower == upper. Entries may overlap; the first matching entry in array
// order wins, as in ODX, so a decoder must not sort or binary-search them.
table TextEntry {
  lower: int64;
  upper: int64;
  text_id: uint32;
}

table CompuTableInterp {
  points: [InterpPoint];
}

struct InterpPoint {
  internal: double;
  physical: double;
}

table CompuRational {
  numerator_coeffs: [double];
  denominator_coeffs: [double];
}

// Equivalent to COMPUCODE. Evaluated with an instruction subset of the procedure part VM (8.2.2).
table CompuBytecode {
  code_offset: uint32; // start position within the procedure part program
}

// ---------------------------------------------------------------- Decode plan

// How a field's length is found (the ODX DIAG-CODED-TYPE kinds, ISO 22901-1 7.3.6.2).
// LeadingLength and Terminated apply only to Bytes, Ascii, Utf8 and Unicode2 fields, which
// start at a byte edge; a Unicode2 field's lengths are even.
enum LengthKind : byte {
  Fixed = 0,          // bit_length bits (STANDARD-LENGTH-TYPE)
  FromField = 1,      // the physical value of field length_field_id, in bits (PARAM-LENGTH-INFO-TYPE)
  LeadingLength = 2,  // a bit_length-bit prefix, read in the field's byte_order, holds the length
                      // in bytes; the value starts at the next byte edge and excludes the prefix
                      // (LEADING-LENGTH-INFO-TYPE)
  Terminated = 3,     // min_bytes to max_bytes, ended early by `termination` (MIN-MAX-LENGTH-TYPE)
}

// What ends a Terminated field before max_bytes. Within the first min_bytes a termination
// byte is ordinary data. A Zero or HexFF terminator is dropped from the value but still
// consumed, so an AfterPrevious field that follows starts after it. A value that reaches
// max_bytes has no terminator.
enum Termination : byte {
  EndOfPdu = 0,  // the end of the message; with max_bytes = 0 this is "all remaining bytes"
  Zero = 1,      // a 0x00 byte (a 0x0000 character for Unicode2)
  HexFF = 2,     // a 0xFF byte (a 0xFFFF character for Unicode2)
}

// Where a field starts within its layout. The layout of a request or response starts at the
// SID byte (offset 0, prefix included); a Layout starts at its own first byte. bit_offset is
// byte position * 8 + bit position, the bit position counting from the least significant bit
// of that byte, as ODX does.
enum Placement : byte {
  Absolute = 0,       // bit_offset bits from the start of the layout
  AfterPrevious = 1,  // the byte edge after the previous field of the layout ends (the layout's
                      // start, after the prefix at top level, for the first field), plus a bit
                      // position of 0-7 in bit_offset; an ODX PARAM without BYTE-POSITION.
                      // A shaped field's end is the end of its last decoded item or layout
}

// A nested layout whose position, size or shape is known only from the message
// (see "Nested layouts" below).
union Shape {
  Repeat,
  Select,
  Group,
}

// Flattened response layout. Monitoring obtains physical values just by walking
// this array (to meet the 10ms target in 10.3). A field with a fixed position, a Fixed length
// and no shape is all monitoring ever sees (MonitorSet).
// Array order is decode order. A field that another field refers to (length, count, key)
// comes first; the frontend rejects ODX data where moving it would change which field an
// AfterPrevious field follows.
table Field {
  // Stable ID for references, from 1. It names the definition, not an occurrence: a field in a
  // layout used at several places, or copied into a MonitorSet, keeps the same id
  id: uint32;
  short_name: string;
  placement: Placement = Absolute;
  bit_offset: uint32;
  length_kind: LengthKind = Fixed;
  // Fixed: the value's width. LeadingLength: the width of the length prefix. Otherwise unused
  bit_length: uint32;
  kind: DataKind;
  byte_order: ByteOrder = Big;
  compu: Compu;
  unit_id: uint32 = 0;        // unit system is resolved on the extension side (9.2)
  // FromField: the field holding the length. It is decoded before this one, in the same layout
  // or an enclosing one; inside a repeated item, the same item's occurrence is meant
  length_field_id: uint32 = 0;
  // Terminated only. max_bytes = 0 means no maximum; otherwise min_bytes <= max_bytes
  min_bytes: uint32 = 0;
  max_bytes: uint32 = 0;
  termination: Termination = EndOfPdu;
  // Absent: a single value decoded by kind and compu. Otherwise a nested layout (ADR-242);
  // kind, compu and the length attributes are then unused, and the field starts at a byte edge
  shape: Shape;
}

// ---------------------------------------------------------------- Nested layouts (ADR-242)

// A group of fields decoded together: an ODX STRUCTURE, or the data of a TABLE-ROW, that a
// Repeat, Select or Group refers to. A STRUCTURE whose position and size are known at import is
// not a Layout: its fields are inlined into the enclosing layout with their positions adjusted.
// Field positions are relative to the start of the layout, which starts at a byte edge.
// Decoding fails if the fields reach past byte_size.
table Layout {
  id: uint32 (key);           // from 1; 0 means "no layout" in references
  short_name: string;
  byte_size: uint32 = 0;      // BYTE-SIZE; 0 = the extent of the decoded fields
  fields: [Field];
}

// One occurrence of a layout whose start or size is known only at runtime: a STRUCTURE after a
// variable-length field or with a variable-length member, or a FIELD or MUX that is not at a
// fixed position (its count or key and its items are then positioned inside the group).
table Group {
  layout_id: uint32;
}

// How many items a Repeat has (the ODX FIELD kinds, 7.3.6.10.3 to 7.3.6.10.6).
enum RepeatCount : byte {
  Fixed = 0,          // fixed_count items, item_byte_size (> 0) bytes apart (STATIC-FIELD)
  FromField = 1,      // the physical value of count_field_id (DYNAMIC-LENGTH-FIELD)
  UntilMarker = 2,    // until `marker` matches or the message ends (DYNAMIC-ENDMARKER-FIELD)
  UntilEndOfPdu = 3,  // until the message ends (END-OF-PDU-FIELD)
}

// A layout repeated a number of times known only from the message. The first item starts where
// the Repeat field is placed. Fixed items are item_byte_size apart and decoding fails if one
// reaches past that; the other kinds start each item at the byte edge after the previous one.
// An item that consumes no bytes ends the repetition, so a repetition always terminates.
table Repeat {
  layout_id: uint32;
  count: RepeatCount;
  fixed_count: uint32 = 0;
  item_byte_size: uint32 = 0;
  // FromField: decoded before the Repeat field (the frontend places ODX's
  // DETERMINE-NUMBER-OF-ITEMS as an ordinary field ahead of it)
  count_field_id: uint32 = 0;
  // UntilMarker: before each item, `marker` (Absolute, offset 0, Fixed length, no shape) is
  // decoded at the current position; an internal value within marker_lower..marker_upper
  // (inclusive) ends the repetition and those bytes are left for the next field
  marker: Field;
  marker_lower: int64;
  marker_upper: int64;
  // In a request (UntilEndOfPdu only): the number of items the procedure must supply.
  // max_items = 0 means no maximum. Ignored when decoding a response
  min_items: uint32 = 0;
  max_items: uint32 = 0;
}

// One layout chosen by a key read from the message: an ODX MUX, or a TABLE-KEY with its
// TABLE-STRUCT (7.3.6.10.7, 7.3.6.11), which is how DID tables and nested DIDs are expressed.
// The Select field is placed where the chosen layout starts; the key is a separate field.
// Keys are compared as internal values; the frontend converts ODX's physical limits and KEYs
// through the key's COMPU-METHOD and rejects keys it cannot convert.
table Select {
  key_field_id: uint32;       // decoded before the Select field
  cases: [SelectCase];        // non-overlapping (the frontend rejects overlaps)
  has_default: bool = false;  // whether an unmatched key is accepted
  default_layout_id: uint32 = 0;  // has_default only: the default case's layout; 0 = no data
}

table SelectCase {
  short_name: string;
  lower: int64;               // inclusive, lower <= upper; a single key has lower == upper
  upper: int64;
  layout_id: uint32 = 0;      // 0 = the key is valid but carries no data
}

// ---------------------------------------------------------------- Diagnostic services

table Request {
  sid: uint8;
  // Fixed byte sequence (sub-function etc. after the SID)
  prefix: [uint8];
  // Where parameters are embedded. Shapes allowed here: Group, Repeat with UntilEndOfPdu,
  // and Select keyed by a parameter the procedure supplies (a TABLE-KEY that names the whole TABLE)
  params: [Field];
}

table PositiveResponse {
  sid: uint8;               // usually request.sid + 0x40
  prefix: [uint8];
  fields: [Field];
}

table NegativeResponse {
  nrc: uint8;
  message_id: uint32;       // user-facing message text (resolved by extension)
  // Whether this NRC is retryable (0x78 ResponsePending etc.)
  retryable: bool = false;
}

table Service {
  id: uint32;
  short_name: string;
  request: Request;
  positive: PositiveResponse;
  negatives: [NegativeResponse];
  // Session and security level required for execution
  required_session: uint8 = 0;
  required_security_level: uint8 = 0;
  // P2 / P2* (ms). Exceeding them is treated as a timeout
  p2_millis: uint32 = 50;
  p2_star_millis: uint32 = 5000;
}

// ---------------------------------------------------------------- DTC

table DtcDefinition {
  code: uint32;             // 3-byte DTC
  display_code: string;     // "P0301" etc.
  message_id: uint32;
  // Bit definitions of the status byte
  status_fields: [Field];
  // Freeze frame layout
  snapshot_fields: [Field];
  // Extended data layout
  extended_fields: [Field];
}

// ---------------------------------------------------------------- Communication parameters

// COMPARAM is defined close to the D-PDU API, so the mapping to J2534 lives on the worker side (8.5).
// Here it is held as standard-neutral values.
table ComParam {
  short_name: string;
  value: int64;
  unit_id: uint32 = 0;
}

table Protocol {
  short_name: string;       // "ISO15765" etc.
  baud_rate: uint32;
  // Addressing
  tx_id: uint32;
  rx_id: uint32;
  functional_id: uint32 = 0;
  extended_addressing: bool = false;
  params: [ComParam];
}

// ---------------------------------------------------------------- Flash description

enum FlashStep : byte {
  EnterProgrammingSession = 0,
  SecurityAccess = 1,
  EraseMemory = 2,
  RequestDownload = 3,
  TransferData = 4,
  TransferExit = 5,
  CheckMemory = 6,
  EcuReset = 7,
}

table FlashSegment {
  short_name: string;
  start_address: uint64;
  length: uint64;
  // Offset within the distributed artifact. The payload is an OEM-signed binary and is not re-signed (11.1)
  artifact_offset: uint64;
  block_size: uint32;
  checksum: [uint8];
}

table FlashSession {
  id: uint32;
  short_name: string;
  steps: [FlashStep];
  segments: [FlashSegment];
  // Preconditions (8.9). Not executed if they are not met
  min_voltage_mv: uint32 = 0;
  max_voltage_mv: uint32 = 0;
  require_ignition_on: bool = true;
  require_engine_off: bool = true;
  require_vehicle_stopped: bool = true;
  // Whether an interruption in this range requires on-site intervention (8.10.1)
  recovery_required_from_step: uint8 = 2; // default: from the start of erase onward
}

// ---------------------------------------------------------------- ECU variants

// Variant identification (equivalent to ECU-VARIANT-PATTERN).
// Runs identification services and selects the variant whose responses match (integrated into the pre-check in 8.9.1).
table VariantPattern {
  service_id: uint32;       // identification service to run
  field_id: uint32;         // field to compare
  expected: [uint8];        // expected value (prefix match)
}

table EcuVariant {
  id: uint32;
  short_name: string;
  part_numbers: [string];
  sw_versions: [string];
  patterns: [VariantPattern];

  protocols: [Protocol];
  services: [Service];
  dtcs: [DtcDefinition];
  flash_sessions: [FlashSession];
  // Targets of Repeat, Select and Group fields, sorted by id (ADR-242)
  layouts: [Layout];

  // Decode plans pre-expanded for monitoring (10.2)
  monitor_sets: [MonitorSet];
}

// A set of PIDs read together. Multiple values are fetched in one request.
table MonitorSet {
  id: uint32;
  short_name: string;
  service_id: uint32;
  // Fixed position, Fixed length and no shape only, so that decoding stays a flat walk
  fields: [Field];
  // Nominal period achievable with this set (ms). Measured values take precedence (10.3)
  nominal_period_millis: uint32;
}

// ---------------------------------------------------------------- Root

table EcuDocument {
  schema_version: uint32;
  // Provenance of the input format (8.2). "odx" | "csv-js" etc.
  source_format: string;
  source_digest: string;     // hash of the original file
  variant: EcuVariant;
  // Procedure part program (postcard-serialized bytes). Corresponds to Program
  procedure: [uint8];
}

root_type EcuDocument;
