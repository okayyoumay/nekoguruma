# The device-mode agent on Linux (design 6.2, 6.5). Installation and the exit statuses the
# restart policy rests on: crates/agent/docs/ngr-agent.md ("Installation (Linux)").
[Unit]
Description=Nekoguruma agent (device mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A static account, created by sysusers.d/ngr-agent.conf; no DynamicUser=, since the state
# directory and the agent key must belong to the same account across restarts.
User=ngr-agent
Group=ngr-agent
# systemd creates /var/lib/nekoguruma owned by the account above. The agent's built-in device
# state root is that path (crates/agent/src/state.rs) and it creates only sub-directories.
StateDirectory=nekoguruma
StateDirectoryMode=0700
# The agent key: a credential an administrator seals once with `ngr-agent provision-key` (ADR-498).
# systemd decrypts it before the agent starts and passes it in $CREDENTIALS_DIRECTORY. A missing or
# undecryptable file fails the unit at start, and the restart policy below keeps retrying it.
LoadCredentialEncrypted=nekoguruma-agent-key.device.v1:/etc/credstore.encrypted/nekoguruma-agent-key.device.v1
ExecStart=/usr/bin/ngr-agent connect --mode device
# Exit 3 (the installation file, a lock, the state directory, the registration record or the key
# store, such as an unreadable credential, cannot be read or used for now) is worth a retry,
# and so is a crash. Exit 1 (no installation file at /etc/nekoguruma/agent.toml or one that is
# refused, not valid or for user mode, not registered, no key store), 2 (invalid command line)
# and 4 (the key is present and unusable) repeat until an administrator acts; exit 0 is a stop.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=1 2 4

[Install]
WantedBy=multi-user.target
